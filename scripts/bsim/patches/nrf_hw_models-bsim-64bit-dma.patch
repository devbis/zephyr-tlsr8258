diff --git a/src/nrfx/hal_replacements/hal/nrf_uarte.h b/src/nrfx/hal_replacements/hal/nrf_uarte.h
new file mode 100644
--- /dev/null
+++ b/src/nrfx/hal_replacements/hal/nrf_uarte.h
@@ -0,0 +1,60 @@
+/*
