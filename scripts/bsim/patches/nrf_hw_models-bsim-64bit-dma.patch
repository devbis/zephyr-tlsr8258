+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#ifndef HAL_REPLACEMENTS_HAL_NRF_UARTE_H
+#define HAL_REPLACEMENTS_HAL_NRF_UARTE_H
+
+#include <stdint.h>
+
+#define nrf_uarte_tx_ptr_set nrf_uarte_tx_ptr_set_host
+#define nrf_uarte_tx_buffer_set nrf_uarte_tx_buffer_set_host
+#define nrf_uarte_rx_ptr_set nrf_uarte_rx_ptr_set_host
+#define nrf_uarte_rx_buffer_set nrf_uarte_rx_buffer_set_host
+#include_next "hal/nrf_uarte.h"
+#undef nrf_uarte_tx_ptr_set
+#undef nrf_uarte_tx_buffer_set
+#undef nrf_uarte_rx_ptr_set
+#undef nrf_uarte_rx_buffer_set
+
+extern NRF_UARTE_Type NRF_UARTE_regs[];
+void nhw_UARTE_tx_ptr_set(unsigned int inst, uintptr_t ptr);
+void nhw_UARTE_rx_ptr_set(unsigned int inst, uintptr_t ptr);
+
+static inline uint32_t nrf_uarte_instance_get(NRF_UARTE_Type const *p_reg)
+{
+    return ((uintptr_t)p_reg - (uintptr_t)NRF_UARTE_regs) / sizeof(*p_reg);
+}
+
+static inline void nrf_uarte_tx_ptr_set(NRF_UARTE_Type *p_reg,
+                                        uint8_t const *p_buffer)
+{
+    nrf_uarte_tx_ptr_set_host(p_reg, p_buffer);
+    nhw_UARTE_tx_ptr_set(nrf_uarte_instance_get(p_reg), (uintptr_t)p_buffer);
+}
+
+static inline void nrf_uarte_tx_buffer_set(NRF_UARTE_Type *p_reg,
+                                            uint8_t const *p_buffer,
+                                            size_t length)
+{
+    nrf_uarte_tx_buffer_set_host(p_reg, p_buffer, length);
+    nhw_UARTE_tx_ptr_set(nrf_uarte_instance_get(p_reg), (uintptr_t)p_buffer);
+}
+
+static inline void nrf_uarte_rx_ptr_set(NRF_UARTE_Type *p_reg, uint8_t *p_buffer)
+{
+    nrf_uarte_rx_ptr_set_host(p_reg, p_buffer);
+    nhw_UARTE_rx_ptr_set(nrf_uarte_instance_get(p_reg), (uintptr_t)p_buffer);
+}
+
+static inline void nrf_uarte_rx_buffer_set(NRF_UARTE_Type *p_reg,
+                                            uint8_t *p_buffer,
+                                            size_t length)
+{
+    nrf_uarte_rx_buffer_set_host(p_reg, p_buffer, length);
+    nhw_UARTE_rx_ptr_set(nrf_uarte_instance_get(p_reg), (uintptr_t)p_buffer);
+}
+
+#endif /* HAL_REPLACEMENTS_HAL_NRF_UARTE_H */
