+
+uintptr_t nhw_RADIO_packetptr_get(void)
+{
+  if ((uint32_t)nhw_radio_packetptr_host != NRF_RADIO_regs.PACKETPTR) {
+    return NRF_RADIO_regs.PACKETPTR;
+  }
+
+  return nhw_radio_packetptr_host;
+}
