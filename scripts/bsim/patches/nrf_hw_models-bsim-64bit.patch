@@ -0,0 +1,46 @@
+/*
+ * Copyright (c) 2026 Nordic Semiconductor ASA
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#ifndef HAL_REPLACEMENTS_HAL_NRF_RADIO_H
+#define HAL_REPLACEMENTS_HAL_NRF_RADIO_H
+
+#include <stdint.h>
+#include <NHW_misc.h>
+
+#define nrf_radio_packetptr_set nrf_radio_packetptr_set_host
+#define nrf_radio_task_address_get nrf_radio_task_address_get_host
+#define nrf_radio_event_address_get nrf_radio_event_address_get_host
+#include_next "hal/nrf_radio.h"
+#undef nrf_radio_packetptr_set
+#undef nrf_radio_task_address_get
+#undef nrf_radio_event_address_get
+
+#if NRF_RADIO_HAS_PACKETPTR
+void nhw_RADIO_packetptr_set(uintptr_t ptr);
+static inline void nrf_radio_packetptr_set(NRF_RADIO_Type *p_reg, void const *p_packet)
+{
+    nrf_radio_packetptr_set_host(p_reg, p_packet);
+    nhw_RADIO_packetptr_set((uintptr_t)p_packet);
+}
+#endif
+
+static inline uint32_t nrf_radio_task_address_get(NRF_RADIO_Type const *p_reg,
+                                                   nrf_radio_task_t task)
+{
+    uintptr_t address = (uintptr_t)p_reg + (uint32_t)task;
+
+    return (uint32_t)(uintptr_t)nhw_convert_per_addr_sim_to_hw((void *)address);
+}
+
+static inline uint32_t nrf_radio_event_address_get(NRF_RADIO_Type const *p_reg,
+                                                    nrf_radio_event_t event)
+{
+    uintptr_t address = (uintptr_t)p_reg + (uint32_t)event;
+
+    return (uint32_t)(uintptr_t)nhw_convert_per_addr_sim_to_hw((void *)address);
+}
+
+#endif /* HAL_REPLACEMENTS_HAL_NRF_RADIO_H */
