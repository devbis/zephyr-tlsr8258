/* Z-Stack host UART for slwrb4180a: USART0 on PB0 (RX) and PB1 (TX). The
 * coordinator build turns the console off, so the UART carries only the NCP
 * protocol. Router and end device builds keep the board's default pins.
 */

#include <zephyr/dt-bindings/pinctrl/silabs/xg21-pinctrl.h>

&pinctrl {
	usart0_ncp_default: usart0_ncp_default {
		group0 {
			pins = <USART0_TX_PB1>;
			drive-push-pull;
			output-high;
		};

		group1 {
			pins = <USART0_RX_PB0>;
			input-enable;
			silabs,input-filter;
		};
	};
};

&usart0 {
	pinctrl-0 = <&usart0_ncp_default>;
	pinctrl-names = "default";
};

/ {
	chosen {
		zigbee,ncp-uart = &usart0;
	};
};
