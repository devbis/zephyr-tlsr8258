if SOC_SERIES_TLSR826X

config NUM_IRQS
	default 24

config SYS_CLOCK_EXISTS
	default y

config SYS_CLOCK_HW_CYCLES_PER_SEC
	default 16000000

# See soc/telink/tlsr/tlsr825x/Kconfig.defconfig for the 64-bit timeout trade-off.
config TIMEOUT_64BIT
	default n

config HAS_FLASH_LOAD_OFFSET
	default y if BOOTLOADER_MCUBOOT

config FLASH_BASE_ADDRESS
	default 0x0

config FLASH_SIZE
	default 512

config SRAM_BASE_ADDRESS
	default 0x808000

config SRAM_SIZE
	default 32

config MAIN_STACK_SIZE
	default 2048

config IDLE_STACK_SIZE
	default 1024

config TEST_EXTRA_STACK_SIZE
	default 1024

endif # SOC_SERIES_TLSR826X
