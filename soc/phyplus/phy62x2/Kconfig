config SOC_PHY62X2
	select ARM
	select CPU_CORTEX_M0
	select CPU_CORTEX_M_HAS_SYSTICK
	select HAS_POWEROFF
	select SOC_PREP_HOOK
	select XIP

config PHY62X2_DEEP_SLEEP
	bool "Deep sleep with retained RAM"
	depends on SOC_PHY62X2
	help
	  Provide phy62x2_deep_sleep(): the chip sleeps until a timeout or a wake pad and starts from the
	  boot ROM, keeping the RAM of the zephyr,retained-ram nodes. It has not been tried on hardware.

config PHY62X2_SUSPEND
	bool "Suspend to RAM"
	depends on SOC_PHY62X2
	help
	  Provide phy62x2_suspend(): the chip sleeps with its RAM retained and the program continues after the
	  wakeup. The registers of the peripherals are lost in the sleep. It has not been tried on hardware.

config PHY62X2_WATCHDOG
	bool "Reset the chip when the system hangs"
	default y
	depends on SOC_PHY62X2 && WATCHDOG && DT_HAS_SNPS_DESIGNWARE_WATCHDOG_ENABLED
	help
	  Start the watchdog at boot and feed it from a thread of the lowest priority. A thread of a
	  higher priority that does not leave the CPU, or interrupts that stay locked, stop the
	  feeding and the chip is reset. Disable it where the code feeds the watchdog itself
	  (MCUboot).

config PHY62X2_WATCHDOG_TIMEOUT_MS
	int "Timeout of the watchdog in ms"
	default 8000
	depends on PHY62X2_WATCHDOG
	help
	  The timeout comes from the 32 kHz RC oscillator in steps of a power of two, 2 s up to
	  256 s.
