if SOC_PHY62X2

config NUM_IRQS
	default 32

# The peripherals run from the core clock, in MHz; the timing of the I2C is computed from it
config I2C_DW_CLOCK_SPEED
	default 16 if SYS_CLOCK_HW_CYCLES_PER_SEC = 16000000
	default 48 if SYS_CLOCK_HW_CYCLES_PER_SEC = 48000000

endif
