config PINCTRL_TELINK_TLSR8269
	bool "Telink TLSR8269 pin controller"
	default y
	depends on DT_HAS_TELINK_TLSR8269_PINCTRL_ENABLED
	help
	  Enable pin configuration support for Telink TLSR8269.
