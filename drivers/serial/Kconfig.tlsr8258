config UART_TELINK_TLSR8258
	bool "Telink TLSR8258 UART driver"
	default y
	depends on DT_HAS_TELINK_TLSR8258_UART_ENABLED
	select SERIAL_HAS_DRIVER
	select SERIAL_SUPPORT_INTERRUPT
	select SERIAL_SUPPORT_ASYNC
	select PINCTRL
	help
	  This option enables the UART driver for Telink TLSR8258.

config UART_TLSR8258_DMA
	bool "Telink TLSR8258 UART DMA for the async API"
	default n
	depends on UART_TELINK_TLSR8258 && UART_ASYNC_API
	select TLSR825X_DMA_IRQ
	help
	  Move async UART TX and RX through DMA1 and DMA0 instead of the
	  interrupt-driven FIFO path. The DMA interrupt line is shared with
	  the 802.15.4 radio through the SoC's DMA interrupt dispatcher.

config UART_TLSR8258_IRQ_DMA_RX
	bool "Telink TLSR8258 UART receive through DMA for the interrupt-driven API"
	default n
	depends on UART_TELINK_TLSR8258 && UART_INTERRUPT_DRIVEN && !UART_ASYNC_API
	select TLSR825X_DMA_IRQ
	help
	  Receive through DMA0 and serve the interrupt-driven API from a
	  software ring buffer: uart_irq_rx_enable() arms the DMA, the DMA
	  completion interrupt moves a received packet into the ring and calls
	  the user callback, uart_fifo_read() drains the ring.

	  The four-byte receive FIFO of the interrupt-driven path is too
	  shallow for the latency of the interrupt handler, and its interrupt
	  is also raised by the transmit flags. The vendor driver receives
	  through DMA for the same reasons.

	  The DMA interrupt line is shared with the 802.15.4 radio through the
	  SoC's DMA interrupt dispatcher.

if UART_TLSR8258_IRQ_DMA_RX

config UART_TLSR8258_IRQ_DMA_RX_BUF_SIZE
	int "DMA receive buffer size"
	default 2048
	range 32 4080
	help
	  Size of one DMA packet including its four-byte length. A burst of
	  bytes longer than this is cut into several packets.

config UART_TLSR8258_IRQ_DMA_RX_RING_SIZE
	int "Receive ring buffer size"
	default 2048
	range 64 32768
	help
	  Bytes held between the DMA interrupt and uart_fifo_read(). Bytes
	  that do not fit are dropped.

endif # UART_TLSR8258_IRQ_DMA_RX
