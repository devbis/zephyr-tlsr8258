config FLASH_PHY62X2
	bool "PHY62x2 flash controller"
	default y
	depends on DT_HAS_PHYPLUS_PHY62X2_FLASH_CONTROLLER_ENABLED
	select FLASH_HAS_DRIVER_ENABLED
	select FLASH_HAS_PAGE_LAYOUT
	select FLASH_HAS_EXPLICIT_ERASE
	help
	  Enable the PHY62x2 flash controller. Program and erase operations
	  execute from SRAM while interrupts are locked.
