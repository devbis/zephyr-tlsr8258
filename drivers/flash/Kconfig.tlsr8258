config SOC_FLASH_TELINK_TLSR8258
	bool "Telink TLSR8258 on-chip flash driver"
	default y
	depends on DT_HAS_TELINK_TLSR8258_FLASH_ENABLED
	select FLASH_HAS_DRIVER_ENABLED
	select FLASH_HAS_EXPLICIT_ERASE
	select FLASH_HAS_PAGE_LAYOUT
	help
	  Enable the flash driver for the SPI flash connected to the
	  TLSR8258 internal MSPI controller.

config FLASH_TLSR8258_BLOCK_PROTECT
	bool "Write-protect the lowest 256 KiB at boot"
	default n
	depends on SOC_FLASH_TELINK_TLSR8258
	help
	  Set the block-protect bits of the external flash status register to
	  cover the lowest 256 KiB, as the vendor SDK does at boot when
	  FLASH_PROTECT_ENABLE is set. Only the MIDs in the vendor table are
	  handled; other flashes are left unprotected. The bits persist across
	  reboots, so external programmers must clear them before erasing.
