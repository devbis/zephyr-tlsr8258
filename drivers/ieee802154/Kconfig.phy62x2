menuconfig IEEE802154_PHY62X2
	bool "Phyplus PHY62x2 IEEE 802.15.4 radio"
	default y
	depends on DT_HAS_PHYPLUS_PHY62X2_RADIO_ENABLED
	help
	  Enable the experimental IEEE 802.15.4 radio driver for Phyplus PHY62x2.
	  The RF register setup is based on an unverified PHY62x2/PHY62x2 backend.

if IEEE802154_PHY62X2

config IEEE802154_PHY62X2_INIT_PRIO
	int "PHY62x2 IEEE 802.15.4 initialization priority"
	default 80

endif # IEEE802154_PHY62X2
