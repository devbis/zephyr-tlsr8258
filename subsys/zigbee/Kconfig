config ZIGBEE_GP_SINK
	bool "Green Power sink (combo)"
	depends on ZIGBEE_GP
	select ZIGBEE_ZCL_ON_OFF
	select ZIGBEE_ZCL_LEVEL_CTRL
	help
	  Build the Green Power sink and translation table (vendor
	  GP_BASIC_COMBO) next to the proxy, so the node can pair with
	  Green Power devices and act on their commands itself. Needs
	  extra flash and RAM on top of CONFIG_ZIGBEE_GP.

config ZIGBEE_NCP
	bool "Serial network co-processor interface"
	depends on ZIGBEE_COORDINATOR
	default y
	select SERIAL
	help
	  Let a host drive the coordinator over a UART, the way it would a
	  dedicated coordinator adapter. The protocol is chosen below. A
	  coordinator is driven by a host unless this is turned off.

if ZIGBEE_NCP

choice ZIGBEE_NCP_PROTOCOL
	prompt "NCP protocol"
	default ZIGBEE_NCP_ZSTACK

config ZIGBEE_NCP_TELINK
	bool "Telink ZBHCI"
	help
	  Expose a narrow subset of Telink's vendor ZBHCI UART protocol
	  (network start, permit-join, child-node list, AF data send, ZDO
	  active-EP/simple-desc query), so a host tool can drive the
	  coordinator the same way it would a real Telink coordinator's
	  serial port. Framing and command-ID layout are adapted from
	  tl_zigbee_sdk's zbhci/ module (Apache-2.0, Telink Semiconductor);
	  only the commands listed above are implemented.

config ZIGBEE_NCP_ZSTACK
	bool "TI Z-Stack ZNP"
	help
	  Emulate the serial interface of a Z-Stack 3.0.x ZNP coordinator,
	  limited to the commands Zigbee2MQTT (adapter: zstack) and ZHA
	  (zigpy-znp) use to start the network, manage devices and exchange
	  APS data. Other commands are answered with an error.

endchoice

endif # ZIGBEE_NCP

config ZIGBEE_ZBHCI_UART
	def_bool ZIGBEE_NCP_TELINK

config ZIGBEE_ZSTACK_NCP
	def_bool ZIGBEE_NCP_ZSTACK

config ZIGBEE_OTA
	bool "OTA firmware update"
	depends on BOOTLOADER_MCUBOOT
	depends on FLASH_MAP
	select IMG_MANAGER
	select STREAM_FLASH
	help
	  Zigbee OTA Upgrade client. The server sends a standard Zigbee OTA
	  file whose image element is an MCUboot image signed with imgtool.
	  The client writes the element to slot 1 (the "slot1_partition"
	  devicetree node, see the tlsr8258-mcuboot snippet), and the
	  application calls ota_mcuReboot() on OTA_EVT_COMPLETE to have MCUboot
	  verify and test the image. The new image is confirmed once the device
	  is on the network; MCUboot reverts it on the next reset otherwise.

config ZIGBEE_OTA_CONFIRM_DELAY_S
	int "Delay before a new image is confirmed"
	default 30
	range 1 3600
	depends on ZIGBEE_OTA
	help
	  Time in seconds after boot before a test image that is joined to a
	  network marks itself as confirmed.

config ZIGBEE_MANUFACTURER_CODE
	hex "Manufacturer code"
	default 0x1141 if ZIGBEE_RADIO_PORT_TLSR8258 || ZIGBEE_RADIO_PORT_TLSR8269
	default 0x1002 if SOC_FAMILY_SILABS_S1 || SOC_FAMILY_SILABS_S2
	default 0x131B if SOC_FAMILY_ESPRESSIF_ESP32
	default 0x1279 if SOC_FAMILY_NORDIC_NRF
	default 0x1055 if SOC_FAMILY_BFLB
	default 0x123C if SOC_FAMILY_PHYPLUS
	default 0x0000
	range 0x0000 0xFFFF
	help
	  Manufacturer code of the node descriptor, which a coordinator reads, and
	  the value the OTA files of the product carry. The default is the code of
	  the SoC vendor: 0x1141 Telink, 0x1002 Silicon Labs (EFR32), 0x131B
	  Espressif, 0x1279 Nordic, 0x1055 Bouffalo Lab, 0x123C PHYPLUS (PHY62xx).
	  A product that ships under its own code sets it here. Zero, the default
	  on other SoCs, is not a registered code: the build warns until a code is
	  set.

config ZIGBEE_WWAH
	bool "Works With All Hubs"
	depends on ZIGBEE_ZCL
	select ZIGBEE_ZCL_WWAH
	default n
	help
	  Build the WWAH cluster server (wwah/). The application calls
	  wwah_init() after registering its endpoint. The attributes the
	  hub sets are stored in NV and applied again after a reset.

config ZIGBEE_MAC_TIMER_CYCLES_PER_US
	int "Zigbee MAC timer cycles per microsecond"
	default 24 if ZIGBEE_RADIO_PORT_TLSR8258
	default 24 if ZIGBEE_RADIO_PORT_TLSR8269
	default 16
	range 1 1000
	help
	  Compatibility scale for vendor MAC code that measures deadlines in
	  clock_time() cycles. The TLSR8258 Zigbee MAC path is hardware-verified
	  with the vendor 24-cycle timing scale even though Zephyr's system timer
	  runs at 16 MHz.

module = ZIGBEE
module-str = zigbee
source "subsys/logging/Kconfig.template.log_config"

endif # ZIGBEE

config ZIGBEE_RADIO_PORT
	bool

config ZIGBEE_RADIO_PORT_TLSR8258
	bool
	depends on IEEE802154_TELINK_TLSR8258
	select ZIGBEE_RADIO_PORT
	select CRYPTO
	default y if IEEE802154_TELINK_TLSR8258

config ZIGBEE_RADIO_PORT_TLSR8269
	bool
	depends on IEEE802154_TELINK_TLSR8269
	select ZIGBEE_RADIO_PORT
	select CRYPTO
	default y if IEEE802154_TELINK_TLSR8269

config ZIGBEE_AES_ENGINE
	bool
	depends on ZIGBEE
	default y if DT_HAS_ESPRESSIF_ESP32_AES_ENABLED || \
		     (DT_HAS_NORDIC_NRF_ECB_ENABLED && !HAS_BT_CTLR)
	select CRYPTO
	help
	  The SoC has an AES engine that the crypto API drives for the Zigbee
	  security service. The engine driver itself is enabled by default once
	  CRYPTO is.

config ZIGBEE_AES_SOFTWARE
	bool
	default y if !(CRYPTO_TLSR8258 || CRYPTO_ESP32_AES)
	help
	  Build the software AES-128 cipher. It is the whole implementation
	  when no engine is available, and the decrypt direction on the nRF
	  ECB peripheral, which only encrypts.

config ZIGBEE_RADIO_PORT_GENERIC
	bool
	depends on NET_L2_CUSTOM_IEEE802154 && !IEEE802154_TELINK_TLSR8258 && !IEEE802154_TELINK_TLSR8269
	select ZIGBEE_RADIO_PORT
	default y
