menuconfig ZIGBEE
	bool "Zigbee protocol support"
	depends on ZIGBEE_RADIO_PORT
	select NVS
	select FLASH
	select FLASH_MAP
	select HWINFO
	help
	  Enable Zigbee subsystem.
	  AES-128 is provided by the TLSR8258 hardware accelerator.

if ZIGBEE

choice ZIGBEE_ROLE
	prompt "Zigbee device role"
	default ZIGBEE_ED

config ZIGBEE_ED
	bool "End Device"

config ZIGBEE_ROUTER
	bool "Router"

endchoice

config ZIGBEE_ED_LIBZIGBEE
	bool "Experimental: ED from full libzigbee stack"
	depends on ZIGBEE_ED
	default n
	help
	  Experimental: build the ED from the full libzigbee stack (ZB_ED_ROLE)
	  instead of the minimal path.

config ZIGBEE_NATIVE_SIM_IEEE_LOW
	hex "native_sim fixed IEEE address low byte"
	default 0x02
	help
	  Low byte of the compiled-in IEEE address on native_sim/POSIX builds
	  (full address a4:c1:38:e0:50:02:00:XX). Build a second node with a
	  distinct value so multiple native_sim Zigbee nodes (e.g. an End Device
	  joining THROUGH a router) can share one socket medium.

config ZIGBEE_CHANNEL
	int "Default Zigbee channel"
	default 15
	range 11 26

config ZIGBEE_STACK_SIZE
	int "Zigbee thread stack size"
	default 2048

config ZIGBEE_THREAD_PRIO
	int "Zigbee thread priority"
	default 5

config ZIGBEE_BDB
	bool "Base Device Behavior"
	default y

config ZIGBEE_ZCL
	bool "Zigbee Cluster Library"
	default y

config ZIGBEE_GP
	bool "Green Power"
	default n

config ZIGBEE_OTA
	bool "OTA firmware update"
	default n

config ZIGBEE_WWAH
	bool "Works With All Hubs"
	default n

config ZIGBEE_NV_SECTOR_COUNT
	int "NVS sector count for Zigbee storage"
	default 2

config ZIGBEE_LOG_LEVEL
	int "Zigbee log level"
	default 3

config ZIGBEE_MAC_TIMER_CYCLES_PER_US
	int "Zigbee MAC timer cycles per microsecond"
	default 24 if ZIGBEE_RADIO_PORT_TLSR8258
	default 16
	range 1 1000
	help
	  Compatibility scale for vendor MAC code that measures deadlines in
	  clock_time() cycles. The TLSR8258 Zigbee MAC path is hardware-verified
	  with the vendor 24-cycle timing scale even though Zephyr's system timer
	  runs at 16 MHz.

config ZIGBEE_MAC_TRX_STUBS
	bool "Enable weak MAC trx stubs"
	default n
	help
	  Build weak MAC trx stub handlers for incomplete stack integration.
	  Keep this disabled for normal Zigbee builds.

config ZIGBEE_DEBUG_TRACES
	bool "Enable Zigbee debug trace buffers"
	default n
	help
	  Keep RAM-backed debug trace buffers used for low-level Zigbee bring-up.
	  Disable this for normal builds to reduce RAM pressure and avoid keeping
	  always-on diagnostics in production images.

endif # ZIGBEE

config ZIGBEE_RADIO_PORT
	bool

config ZIGBEE_RADIO_PORT_TLSR8258
	bool
	depends on IEEE802154_TELINK_TLSR8258
	select ZIGBEE_RADIO_PORT
	default y if IEEE802154_TELINK_TLSR8258

config ZIGBEE_RADIO_PORT_NATIVE_SIM_SOCKET
	bool
	depends on IEEE802154_NATIVE_SIM_SOCKET
	select ZIGBEE_RADIO_PORT
	default y if IEEE802154_NATIVE_SIM_SOCKET
