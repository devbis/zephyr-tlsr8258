DT_CHOSEN_ZIGBEE_RETAINED_MEM := zigbee,retained-mem

menuconfig ZIGBEE
	bool "Zigbee protocol support"
	depends on ZIGBEE_RADIO_PORT
	depends on NET_L2_CUSTOM_IEEE802154
	depends on !IEEE802154_L2_PKT_INCL_FCS
	select NVS
	select FLASH
	select FLASH_MAP
	select HWINFO
	help
	  Enable Zigbee subsystem.
	  AES-128 is provided by the TLSR8258 hardware accelerator.
	  Other targets use the software implementation.

	  Zigbee runs its own MAC on top of the IEEE 802.15.4 radio driver and
	  receives through a custom L2, so it is only available with
	  CONFIG_NET_L2_CUSTOM_IEEE802154 enabled, an IEEE 802.15.4 radio driver
	  enabled, and CONFIG_IEEE802154_L2_PKT_INCL_FCS disabled.

if ZIGBEE

choice ZIGBEE_ROLE
	prompt "Zigbee device role"
	default ZIGBEE_ED

config ZIGBEE_ED
	bool "End Device"

config ZIGBEE_ROUTER
	bool "Router"

config ZIGBEE_COORDINATOR
	bool "Coordinator"

endchoice

config ZIGBEE_NATIVE_SIM_IEEE_LOW
	hex "native_sim fixed IEEE address low byte"
	default 0x02
	help
	  Low byte of the compiled-in IEEE address on native_sim/POSIX builds
	  (full address a4:c1:38:e0:50:02:00:XX). Build a second node with a
	  distinct value so multiple native_sim Zigbee nodes (e.g. an End Device
	  joining THROUGH a router) can share one socket medium.

config ZIGBEE_CHANNEL_MASK
	hex "Zigbee channel mask"
	default 0x07FFF800
	help
	  Channels (bit N = channel N, valid 11..26) that a router or end
	  device scans when joining, and that a coordinator chooses from when
	  forming a network. The default is all channels. A coordinator picks
	  the least busy channel of a multi-channel mask. Set a single bit
	  (for example 0x800 for channel 11) to pin the node to one channel.

config ZIGBEE_STACK_SIZE
	int "Zigbee thread stack size"
	default 2048

config ZIGBEE_THREAD_PRIO
	int "Zigbee thread priority"
	default 5

config ZIGBEE_BDB
	bool "Base Device Behavior"
	default y

config ZIGBEE_SLEEPY
	bool "Sleepy end device"
	depends on ZIGBEE_ED
	depends on ZIGBEE_BDB
	depends on PM
	depends on TICKLESS_KERNEL
	default y
	help
	  Let a joined end device sleep between parent polls. A battery powered
	  device sleeps by default; disable this for a device that must stay
	  reachable, for example while debugging. Routers and coordinators never
	  sleep: they hold every power state for the whole run.

if ZIGBEE_SLEEPY

choice ZIGBEE_SLEEPY_MODE
	prompt "Sleepy end device sleep mode"
	default ZIGBEE_SLEEPY_DEEP

config ZIGBEE_SLEEPY_DEEP
	bool "Deep sleep (the device restarts on wake)"
	depends on HAS_PM_STATE_SOFT_OFF
	depends on $(dt_chosen_enabled,$(DT_CHOSEN_ZIGBEE_RETAINED_MEM))
	select RETAINED_MEM
	help
	  Enter PM_STATE_SOFT_OFF between polls. RAM is not kept: every wake
	  boots the firmware, restores the network state from non-volatile
	  storage and polls the parent. The outgoing security frame counter
	  survives in the retained memory chosen by zigbee,retained-mem. Pick
	  this for battery powered devices.

config ZIGBEE_SLEEPY_LIGHT
	bool "Light sleep (RAM is kept, execution resumes in place)"
	help
	  Suspend between polls without a restart. Use it where a boot costs
	  more energy than the device can spare, for example a switch powered
	  through the load it controls.

endchoice

endif # ZIGBEE_SLEEPY

config ZIGBEE_ED_POLL_INTERVAL_MS
	int "Sleepy end-device parent poll interval"
	depends on ZIGBEE_ED
	range 50 60000
	default 500
	help
	  Interval between data requests to the parent in the stable joined
	  state. It is also the sleep time of one deep-sleep cycle.

config ZIGBEE_ED_FAST_POLL_INTERVAL_MS
	int "Sleepy end-device fast poll interval"
	depends on ZIGBEE_ED
	range 20 10000
	default 100
	help
	  Poll interval used while the parent is delivering data, so that a
	  request/response exchange (interview, commands) does not wait a
	  whole slow interval for every frame.

config ZIGBEE_ED_FAST_POLL_WINDOW_MS
	int "Sleepy end-device fast poll window"
	depends on ZIGBEE_ED
	range 0 60000
	default 3000
	help
	  Time the end device keeps the fast poll interval, and stays out of
	  deep sleep, after the last frame received from the parent. Zero
	  disables the fast poll window.

config ZIGBEE_ZCL
	bool "Zigbee Cluster Library"
	default y

config ZIGBEE_GP
	bool "Green Power"
	depends on ZIGBEE_ROUTER
	default n
	help
	  Green Power proxy support (vendor GP_SUPPORT_ENABLE, router-only:
	  the GP proxy relays GPDFs on behalf of GPDs, the sink role is not
	  wired in here). The GP endpoint (242) registers and interviews
	  correctly against Zigbee2MQTT, but no actual Green Power device
	  has been tested against it, so GPDF relaying itself is unverified.
	  On the tlsr8258_tb03f router build this adds ~17 KB flash and
	  ~0.6 KB RAM on top of an already tight RAM budget (~96.6% ->
	  ~97.8%).

